{
  "name": "@hardcoremonk/agentmux",
  "version": "0.5.0",
  "description": "Manage multiple Codex sessions from your browser",
  "license": "MIT",
  "author": "HardcoreMonk",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HardcoreMonk/agentmux.git"
  },
  "homepage": "https://github.com/HardcoreMonk/agentmux",
  "bugs": {
    "url": "https://github.com/HardcoreMonk/agentmux/issues"
  },
  "keywords": [
    "codex",
    "openai",
    "terminal",
    "multiplexer",
    "tmux",
    "codex-cli"
  ],
  "engines": {
    "node": ">=20.9.0"
  },
